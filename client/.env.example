# Frontend Environment Variables
# In production on Vercel: set to your backend API URL (e.g. https://your-backend.onrender.com/api)
# In development: defaults to /api (proxied or served by local backend)
VITE_API_URL=/api

# Google Identity Services Client ID (matches server GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
