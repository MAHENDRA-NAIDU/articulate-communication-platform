# Server Port
PORT=5000
NODE_ENV=production

# Frontend Client URL (For CORS whitelist in production)
CLIENT_URL=https://your-frontend-domain.vercel.app

# MongoDB Connection (MongoDB Atlas Cloud Cluster Recommended for Hosting)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/communication_practice?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=CHANGE_ME_generate_a_random_32_char_string
JWT_EXPIRES_IN=7d

# Admin Registration Invite Secret (Validated securely on backend)
ADMIN_INVITE_SECRET=CHANGE_ME_generate_a_unique_admin_key

# Cloudinary Cloud Storage (Recommended for Production Media Hosting)
# Free accounts available at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Video Upload Limits (in Megabytes, default 2048MB = 2GB)
MAX_VIDEO_SIZE_MB=2048

# Email Delivery Configuration (Choose Option A: Gmail SMTP or Option B: Resend API)
# Option A: Gmail SMTP via Nodemailer (Recommended for sending to arbitrary recipients)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_dedicated_account@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM=your_dedicated_account@gmail.com

# Option B: Resend Email Delivery
# Free accounts available at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here

RESET_TOKEN_EXPIRES_MINUTES=15
OTP_EXPIRES_MINUTES=10

# Google Identity Services / OAuth 2.0 (Required for Google Sign-In)
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Reverse Proxy & Cookie Configuration (Required for Render / Vercel cross-site deployments)
TRUST_PROXY=1
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
