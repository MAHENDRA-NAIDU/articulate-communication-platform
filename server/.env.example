# Server Port
PORT=5000
NODE_ENV=production

# Frontend Client URL (For CORS whitelist in production)
CLIENT_URL=https://your-frontend-domain.vercel.app

# MongoDB Connection (MongoDB Atlas Cloud Cluster Recommended for Hosting)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/communication_practice?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_communication_practice_2025_safe_token
JWT_EXPIRES_IN=7d

# Admin Registration Invite Secret (Validated securely on backend)
ADMIN_INVITE_SECRET=ARTICULATE_ADMIN_2025_SECRET

# Cloudinary Cloud Storage (Recommended for Production Media Hosting)
# Free accounts available at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
